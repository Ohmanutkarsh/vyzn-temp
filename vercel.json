{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/public/static/$1"
    },
    {
      "src": "/overview",
      "dest": "/public/overview.html"
    },
    {
      "src": "/cameras",
      "dest": "/public/cameras.html"
    },
    {
      "src": "/cameras/new",
      "dest": "/public/add-camera.html"
    },
    {
      "src": "/areas",
      "dest": "/public/areas.html"
    },
    {
      "src": "/areas/(.*)",
      "dest": "/public/areas.html"
    },
    {
      "src": "/clips",
      "dest": "/public/clips.html"
    },
    {
      "src": "/clips/(.*)",
      "dest": "/public/clips.html"
    },
    {
      "src": "/settings",
      "dest": "/public/settings.html"
    },
    {
      "src": "/design",
      "dest": "/public/design.html"
    },
    {
      "src": "/login",
      "dest": "/public/index.html"
    },
    {
      "src": "/login/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/setup/(.*)",
      "dest": "/public/index.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}